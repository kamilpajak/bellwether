{
  "schema": "open-web-feed.rules/1",
  "rules": {
    "gnw": {
      "valid_field": "pubDate",
      "valid_format": "%a, %d %b %Y %H:%M GMT",
      "path_prefix": "/news-release/",
      "story_key": "release",
      "page_valid": {
        "selector": "meta[property=\"og:article:published_time\"]",
        "attribute": "content",
        "field": "og:article:published_time",
        "format": "%Y-%m-%dT%H:%MZ"
      },
      "rewrite_hosts": {},
      "title": {
        "selector": "meta[property=\"og:title\"]",
        "attribute": "content"
      },
      "canonical": {
        "selector": "link[rel=\"canonical\"]",
        "attribute": "href"
      },
      "body": {
        "container": "div.main-body-container",
        "paragraph": "p, li, figcaption"
      }
    }
  }
}
