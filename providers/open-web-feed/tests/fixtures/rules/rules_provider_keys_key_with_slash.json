{
  "schema": "open-web-feed.rules/1",
  "rules": {
    "yahoo": {
      "index": "news_sitemap",
      "valid_field": "news:publication_date",
      "valid_format": "%Y-%m-%dT%H:%M:00Z",
      "path_prefix": "/",
      "rewrite_hosts": {},
      "provider_keys": {
        "image_key_after": "https://media.zenfs.com/en/",
        "follow": [
          "business-wire.com/x"
        ],
        "cross_check": {
          "prnewswire.com": "www.prnewswire.com",
          "globenewswire.com": "rss.globenewswire.com",
          "cnwgroup.com": "www.newswire.ca"
        }
      },
      "title": {
        "selector": "meta[property=\"og:title\"]",
        "attribute": "content"
      },
      "canonical": {
        "selector": "link[rel=\"canonical\"]",
        "attribute": "href"
      },
      "body": {
        "container": "div[data-testid=\"article-body\"]",
        "paragraph": "p, li, figcaption"
      }
    }
  }
}
