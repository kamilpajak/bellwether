#!/bin/sh
# One shadow run (architecture.md section 3.5, "The shadow run on the VPS"), started by
# modelgate-shadow.service: `newsvault cut` at now under the store lock into a private directory,
# then `modelgate shadow run` over it with no lock held, then the envelope's spend as textfile
# metrics. Arguments, for a run by hand: --dry-run, --limit N, --ack-cost-model RUN_ID, and with
# --dry-run only --from-seq N. A live run without --limit sends at most MODELGATE_LIMIT requests.
# Exits: 0; 7 retryable (a lock held, the cut past its bound, the vendor unreachable); 8 the
# envelope names why; 2 setup or a setting; 4 an absent input; 137 the cut killed before its bound.
set -u
export LC_ALL=C
: "${NEWSVAULT_IMAGE:?set in newsvault.env}" "${NEWSVAULT_TEXTFILE_DIR:?set in newsvault.env}"
case $NEWSVAULT_TEXTFILE_DIR in
    /*) ;;
    *) echo "NEWSVAULT_TEXTFILE_DIR is not an absolute path: '$NEWSVAULT_TEXTFILE_DIR'" >&2; exit 2 ;;
esac
# The store lock is released within cut_bound + cut_kill of the start;
# services/newsvault/tests/deploy.rs holds that inside the gap the other units leave.
cut_bound=180
cut_kill=30
# Owner decision 2026-11-23: the whole shadow spends at most this many USD.
total_ceiling=15
vault="$HOME/.bellwether/vault"
store="$HOME/.bellwether/modelgate"
key="$HOME/.config/bellwether/model-key"
cache="$HOME/.cache/bellwether"

# setting NAME VALUE ALLOWED: non-empty and made of the ALLOWED characters only.
setting() {
    # shellcheck disable=SC2254 # $3 is a bracket expression's inside, a pattern on purpose
    case $2 in
        '' | *[!$3]*) echo "$1 is unset or not a value: '$2'" >&2; exit 2 ;;
    esac
}
amount() {
    setting "$1" "$2" '0-9.'
    # gawk reads 017 in program text as octal 15 and the binary reads it as 17.
    case $2 in
        .* | *. | *.*.* | 0[0-9]*) echo "$1 is not an amount: '$2'" >&2; exit 2 ;;
    esac
}
amount MODELGATE_RUN_CAP_USD "${MODELGATE_RUN_CAP_USD-}"
amount MODELGATE_DAY_CAP_USD "${MODELGATE_DAY_CAP_USD-}"
amount MODELGATE_TOTAL_CAP_USD "${MODELGATE_TOTAL_CAP_USD-}"
amount MODELGATE_INPUT_PRICE_PER_MTOK "${MODELGATE_INPUT_PRICE_PER_MTOK-}"
setting MODELGATE_GIVE_UP_AFTER_HOURS "${MODELGATE_GIVE_UP_AFTER_HOURS-}" '0-9'
setting MODELGATE_LIMIT "${MODELGATE_LIMIT-}" '0-9'
setting MODELGATE_MODEL "${MODELGATE_MODEL-}" 'A-Za-z0-9._/-'
setting MODELGATE_QUESTIONS "${MODELGATE_QUESTIONS-}" 'A-Za-z0-9._/-'
case $MODELGATE_MODEL:$MODELGATE_QUESTIONS in
    -* | *:[!/]*) echo "MODELGATE_MODEL starts with '-' or MODELGATE_QUESTIONS is not absolute" >&2; exit 2 ;;
esac
case $MODELGATE_LIMIT in
    0*) echo "MODELGATE_LIMIT is 0 or starts with 0: '$MODELGATE_LIMIT'" >&2; exit 2 ;;
esac
# As data, never program text: awk converts a string as decimal.
if ! total=$MODELGATE_TOTAL_CAP_USD ceiling=$total_ceiling \
    awk 'BEGIN { exit !(ENVIRON["total"] + 0 <= ENVIRON["ceiling"] + 0) }'; then
    echo "MODELGATE_TOTAL_CAP_USD $MODELGATE_TOTAL_CAP_USD is above the owner's $total_ceiling USD" >&2
    exit 2
fi

dry=''
floor=''
limited=''
previous=''
for arg; do
    case $previous:$arg in
        --limit:* | --from-seq:*) setting "$previous" "$arg" '0-9'; previous='' ;;
        --ack-cost-model:*) setting "$previous" "$arg" 'A-Za-z0-9.:-'; previous='' ;;
        :--dry-run) dry=yes ;;
        :--from-seq) floor=yes; previous=$arg ;;
        :--limit) limited=yes; previous=$arg ;;
        :--ack-cost-model) previous=$arg ;;
        *) echo "usage: modelgate-shadow [--dry-run [--from-seq N]] [--limit N] [--ack-cost-model RUN_ID]" >&2; exit 2 ;;
    esac
done
if [ -n "$previous" ] || [ "$floor:$dry" = yes: ]; then
    echo "$previous needs a value, or --from-seq came without --dry-run: a floor is fixed for good" >&2
    exit 2
fi

: "${XDG_RUNTIME_DIR:?not set: run as the unit does, or from a login session}"
[ -d "$vault" ] || { echo "no store at $vault" >&2; exit 4; }
[ -d "$store" ] || { echo "no directory at $store; the install creates it" >&2; exit 4; }
[ -n "$dry" ] || [ -f "$key" ] || { echo "no key file at $key" >&2; exit 4; }

mkdir -p "$cache" || exit 2
exec 9>"$XDG_RUNTIME_DIR/bellwether-shadow.lock" || exit 2
flock --nonblock 9 || { echo "another shadow run holds its lock" >&2; exit 7; }
# Under that lock every shadow.* is a killed run's: SIGKILL runs no trap.
rm -rf "${cache:?}"/shadow.*
work=$(mktemp -d "$cache/shadow.XXXXXX") || exit 2
trap 'rm -rf "$work"' EXIT
# dash runs the EXIT trap for a trapped signal only: an untrapped HUP left the cut (2026-11-23).
trap 'exit 130' HUP INT QUIT PIPE TERM
mkdir "$work/cut" || exit 2

at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
cut_started=$(date +%s)
flock --nonblock --conflict-exit-code 7 "$XDG_RUNTIME_DIR/bellwether-store.lock" \
    timeout --kill-after "$cut_kill" "$cut_bound" \
    docker run --rm --name modelgate-shadow-cut --pull never \
    --user "$(id -u):$(id -g)" --read-only --tmpfs /tmp:rw,size=16m --network none \
    --cap-drop ALL --security-opt no-new-privileges \
    --mount "type=bind,src=$vault,dst=/vault,readonly" \
    --mount "type=bind,src=$work/cut,dst=/cut" \
    "$NEWSVAULT_IMAGE" \
    cut --at "$at" --out /cut --non-interactive --format json >&2
status=$?
cut_seconds=$(($(date +%s) - cut_started))
# timeout(1): 124 its TERM ended the client; 137 its KILL did, or the container was killed by
# something else (the kernel's OOM killer), which only the elapsed time tells apart.
case $status in
    124 | 137) docker rm --force modelgate-shadow-cut >/dev/null 2>&1 ;;
esac
[ "$status" -ne 137 ] || [ "$cut_seconds" -lt "$cut_bound" ] || status=124
case $status in
    0) ;;
    7) echo "the store lock or the commit log is held" >&2; exit 7 ;;
    124) echo "the cut passed its $cut_bound s bound" >&2; exit 7 ;;
    137) echo "the cut was killed after $cut_seconds s, before its $cut_bound s bound" >&2; exit 137 ;;
    *) exit "$status" ;;
esac
snapshot=''
found=0
for entry in "$work/cut"/*; do
    [ -d "$entry" ] || continue
    found=$((found + 1))
    snapshot=${entry##*/}
done
[ "$found" -eq 1 ] || { echo "the cut left $found snapshot directories, not one" >&2; exit 2; }

[ -n "$dry$limited" ] || set -- "$@" --limit "$MODELGATE_LIMIT"

set -- "$NEWSVAULT_IMAGE" -- /usr/local/bin/modelgate shadow run \
    --snapshot "/cut/$snapshot" --store /modelgate --questions "$MODELGATE_QUESTIONS" \
    --model "$MODELGATE_MODEL" --run-cap-usd "$MODELGATE_RUN_CAP_USD" \
    --day-cap-usd "$MODELGATE_DAY_CAP_USD" --total-cap-usd "$MODELGATE_TOTAL_CAP_USD" \
    --input-price-per-mtok "$MODELGATE_INPUT_PRICE_PER_MTOK" \
    --give-up-after-hours "$MODELGATE_GIVE_UP_AFTER_HOURS" --non-interactive --format json "$@"
if [ -n "$dry" ]; then
    set -- --network none --mount "type=bind,src=$store,dst=/modelgate,readonly" "$@"
else
    set -- --network bridge --mount "type=bind,src=$store,dst=/modelgate" \
        --mount "type=bind,src=$key,dst=/run/secrets/model-key,readonly" \
        --env BELLWETHER_MODEL_KEY_FILE=/run/secrets/model-key "$@"
fi
docker run --rm --name modelgate-shadow --pull never \
    --user "$(id -u):$(id -g)" --read-only --tmpfs /tmp:rw,size=16m \
    --cap-drop ALL --security-opt no-new-privileges --entrypoint /usr/bin/tini \
    --mount "type=bind,src=$work/cut,dst=/cut,readonly" "$@" >"$work/envelope"
status=$?
cat "$work/envelope"
case $dry:$status in
    :0 | :8) ;;
    *) exit "$status" ;;
esac

# The envelope is one compact line; its cost_micro_usd object holds integers and one null.
cost=$(sed -n 's/.*"cost_micro_usd":{\([^{}]*\)}.*/\1/p' "$work/envelope")
field() {
    printf '%s\n' "$cost" | sed -n "s/.*\"$1\":\([0-9][0-9]*\).*/\1/p"
}
reached=0
if grep -q '"error_code":"cost_cap_reached"' "$work/envelope"; then reached=1; fi
prom="$NEWSVAULT_TEXTFILE_DIR/modelgate-shadow.prom"
last_ok=''
if [ "$status" -eq 0 ]; then
    last_ok=$(date -u +%s)
elif [ -f "$prom" ]; then
    last_ok=$(sed -n 's/^modelgate_shadow_last_success_timestamp_seconds \([0-9][0-9]*\)$/\1/p' "$prom")
fi
tmp="$NEWSVAULT_TEXTFILE_DIR/.modelgate-shadow.prom.$$"
if ! {
    echo '# TYPE modelgate_shadow_spent_micro_usd gauge'
    for scope in run day total; do
        printf 'modelgate_shadow_spent_micro_usd{scope="%s"} %s\n' "$scope" "$(field "$scope")"
    done
    echo '# TYPE modelgate_shadow_cap_micro_usd gauge'
    for scope in run day total; do
        printf 'modelgate_shadow_cap_micro_usd{scope="%s"} %s\n' "$scope" "$(field "${scope}_cap")"
    done
    echo '# TYPE modelgate_shadow_cost_cap_reached gauge'
    echo "modelgate_shadow_cost_cap_reached $reached"
    if [ -n "$last_ok" ]; then
        echo '# TYPE modelgate_shadow_last_success_timestamp_seconds gauge'
        echo "modelgate_shadow_last_success_timestamp_seconds $last_ok"
    fi
} >"$tmp" || grep -q '} $' "$tmp" || ! mv -f "$tmp" "$prom"; then
    echo "the envelope states no cost, or $prom could not be written" >&2
    rm -f "$tmp"
    [ "$status" -ne 0 ] || status=2
fi
exit "$status"
