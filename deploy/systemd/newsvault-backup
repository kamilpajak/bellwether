#!/bin/sh
# The daily copy of one store into Nextcloud (architecture.md section 10, N1). No argument, run by
# newsvault-backup.service under the store lock: `newsvault snapshot` of the commit log, then
# `newsvault blobs pack` of the blobs no pack in the folder holds, then one .tar.gz of the snapshot
# and every other store entry but `blobs`. `modelgate`, run by modelgate-backup.service:
# `modelgate snapshot` under the shadow lock, `modelgate verify` of the copy, one .tar.gz of it.
# Each file is written into the data directory through the AIO container as www-data and renamed,
# the folder registered with `occ files:scan`, each file found by `occ info:file`, then all but the
# 7 newest .tar.gz of that store deleted. No pack or manifest is ever deleted. A work directory an
# earlier run of the same store left is removed first: the units start one run of a store at a
# time. Exits: 2 setup or an unsafe setting, 4 an absent input, 7 a held lock, a snapshot past its
# bound, a read, write, rename, scan or lookup, 8 the copy is in and the retention failed or
# `blobs pack` exited 8 (a pack lost or unrecorded, a blob or dictionary the store could not give);
# else the snapshot's, pack's or verify's own.
set -u
export LC_ALL=C
: "${NEWSVAULT_IMAGE:?set in newsvault.env}" "${NEWSVAULT_TEXTFILE_DIR:?set in newsvault.env}"
case $NEWSVAULT_TEXTFILE_DIR in
    /*) ;;
    *) echo "NEWSVAULT_TEXTFILE_DIR is not an absolute path: '$NEWSVAULT_TEXTFILE_DIR'" >&2; exit 2 ;;
esac
keep=7
# The shadow lock is held within lock_wait + snapshot_bound + snapshot_kill of the start;
# services/newsvault/tests/deploy.rs holds that between two shadow firings.
lock_wait=760
snapshot_bound=150
snapshot_kill=20
packs=''
case $#:${1-} in
    0:)
        what=vault
        base=bellwether-vault-log
        packs=bellwether-vault-blobs
        prom=newsvault-backup.prom
        stamp=newsvault_backup_last_success_timestamp_seconds
        size=newsvault_backup_last_success_bytes
        ;;
    1:modelgate)
        what=modelgate
        base=bellwether-modelgate
        prom=modelgate-backup.prom
        stamp=modelgate_backup_last_success_timestamp_seconds
        size=modelgate_backup_last_success_bytes
        : "${XDG_RUNTIME_DIR:?not set: run as the unit does, or from a login session}"
        ;;
    *) echo "usage: newsvault-backup [modelgate]" >&2; exit 2 ;;
esac
store="$HOME/.bellwether/$what"
stamped='-[0-9]\{8\}T[0-9]\{6\}Z\.tar'
copy="$base$stamped\\.gz"

# check NAME VALUE KIND, KIND one of word, absolute, relative: every '/'-separated part starts with a
# letter or digit and holds only letters, digits, '.', '_' and '-'.
check() {
    value=$2
    case $3:$value in
        word: | word:*/* | absolute: | absolute:[!/]* | relative: | relative:/* | *:*/ | *:*//*)
            echo "$1 is unsafe: '$value'" >&2; exit 2 ;;
    esac
    saved_ifs=$IFS
    IFS=/
    set -f
    for part in ${value#/}; do
        case $part in
            '' | [!A-Za-z0-9]* | *[!A-Za-z0-9._-]*) echo "$1 is unsafe: '$value'" >&2; exit 2 ;;
        esac
    done
    set +f
    IFS=$saved_ifs
}
check NEXTCLOUD_CONTAINER "${NEXTCLOUD_CONTAINER-}" word
check NEXTCLOUD_DATA "${NEXTCLOUD_DATA-}" absolute
check NEXTCLOUD_USER "${NEXTCLOUD_USER-}" word
check NEXTCLOUD_FOLDER "${NEXTCLOUD_FOLDER-}" relative
[ -d "$store" ] || { echo "no store at $store" >&2; exit 4; }

container=$NEXTCLOUD_CONTAINER
dir="$NEXTCLOUD_DATA/$NEXTCLOUD_USER/files/$NEXTCLOUD_FOLDER"
scanned="$NEXTCLOUD_USER/files/$NEXTCLOUD_FOLDER"
as_www() {
    docker exec -u www-data "$container" "$@"
}

# put FILE NAME: FILE written into the folder under the hidden .NAME.part, which Nextcloud's scanner
# skips (Scanner::isPartialFile, 30 to 32 source, read 2026-11-18), and its byte count compared.
put() {
    bytes=$(wc -c <"$1" | tr -d ' ')
    staged="$staged $dir/.$2.part"
    written=$(docker exec -i -u www-data "$container" sh -c 'cat >"$1" && wc -c <"$1"' sh \
        "$dir/.$2.part" <"$1") || { echo "writing $dir/.$2.part in $container failed" >&2; exit 7; }
    written=$(printf '%s' "$written" | tr -d ' \n')
    if [ "$written" != "$bytes" ]; then
        echo "$dir/.$2.part holds $written of $bytes bytes; not renamed" >&2
        exit 7
    fi
}
folder() {
    as_www mkdir -p -- "$dir" || { echo "creating $dir in $container failed" >&2; exit 7; }
}

mkdir -p "$HOME/.cache/bellwether" || exit 2
rm -rf "$HOME/.cache/bellwether/backup-$what".* || exit 2
work=$(mktemp -d "$HOME/.cache/bellwether/backup-$what.XXXXXX") || exit 2
staged=''
# $staged is split into paths: `check` admits no blank or glob character in any part of them.
# shellcheck disable=SC2086
trap 'rm -rf "$work"; if [ -n "$staged" ]; then as_www rm -f -- $staged; fi' EXIT
trap 'exit 130' INT TERM

at=$(date -u +%s)
now=$(date -u +%Y%m%dT%H%M%SZ)
name="$base-$now.tar.gz"
pack="$packs-$now.tar"
packed=0
held=0
if [ "$what" = modelgate ]; then
    # The archive is the snapshot's output and nothing else of the store: the database and the
    # blobs its rows name. A shadow run that fired while the lock is held here would exit 7.
    set -- --pull never --user "$(id -u):$(id -g)" --read-only --network none \
        --cap-drop ALL --security-opt no-new-privileges --entrypoint /usr/bin/tini \
        --mount "type=bind,src=$work,dst=/out"
    flock --timeout "$lock_wait" --conflict-exit-code 7 "$XDG_RUNTIME_DIR/bellwether-shadow.lock" \
        timeout --kill-after "$snapshot_kill" "$snapshot_bound" \
        docker run --rm --name modelgate-backup "$@" \
        --mount "type=bind,src=$store,dst=/modelgate,readonly" \
        "$NEWSVAULT_IMAGE" -- /usr/local/bin/modelgate \
        snapshot --store /modelgate --out /out/store --non-interactive --format json
    status=$?
    case $status in
        0) ;;
        7) echo "a shadow run held its lock for $lock_wait s, or the store's LOCK is held; no copy taken" >&2; exit 7 ;;
        124 | 137)
            docker rm --force modelgate-backup >/dev/null 2>&1
            echo "the snapshot passed its $snapshot_bound s bound; no copy taken" >&2
            exit 7
            ;;
        *) exit "$status" ;;
    esac
    docker run --rm --name modelgate-backup-verify "$@" \
        "$NEWSVAULT_IMAGE" -- /usr/local/bin/modelgate \
        verify --store /out/store --non-interactive --format json || exit
    tar -czf "$work/$name" -C "$work/store" gate.sqlite blobs || exit 2
    folder
else
    set -- --rm --name newsvault-backup --pull never \
        --user "$(id -u):$(id -g)" --read-only --network none \
        --cap-drop ALL --security-opt no-new-privileges \
        --mount "type=bind,src=$store,dst=/vault,readonly" \
        --mount "type=bind,src=$work,dst=/out"
    docker run "$@" "$NEWSVAULT_IMAGE" \
        snapshot --out /out/commit.sqlite3 --non-interactive --format json || exit
    folder
    # What the folder holds, for `blobs pack` to judge: each pack's length and sha256, then every
    # manifest under its own name. Only www-data reads the data directory, so the container's
    # sha256sum reads the packs and its tar carries the manifests out.
    mkdir "$work/manifests" || exit 2
    if ! docker exec -u www-data "$container" sh -c 'cd "$1" || exit; for f in "$2"-*.tar; do [ -f "$f" ] || continue; n=$(wc -c <"$f") && s=$(sha256sum <"$f") || exit; echo "$f" $n "${s%% *}"; done' \
        sh "$dir" "$packs" >"$work/have" ||
        ! docker exec -u www-data "$container" sh -c 'cd "$1" || exit; set -- "$2"-*.tar.manifest; [ -f "$1" ] || exit 0; tar -cf - "$@"' \
            sh "$dir" "$packs" >"$work/manifests.tar" ||
        { [ -s "$work/manifests.tar" ] && ! tar -xf "$work/manifests.tar" -C "$work/manifests"; }; then
        echo "reading the packs and manifests in $dir failed" >&2
        exit 7
    fi
    while read -r _ length _; do held=$((held + length)); done <"$work/have"
    docker run "$@" "$NEWSVAULT_IMAGE" \
        blobs pack --log /out/commit.sqlite3 --have /out/have --manifests /out/manifests \
        --out "/out/$pack" --non-interactive --format json
    packed=$?
    case $packed in 0 | 8) ;; *) exit "$packed" ;; esac

    # The live log and its lock stay out, the snapshot is the archive's commit.sqlite3, and the
    # blob tree is in the packs.
    cd "$store" || exit 4
    set --
    for entry in * .[!.]* ..?*; do
        [ -e "$entry" ] || continue
        case $entry in
            commit.sqlite3 | commit.sqlite3-* | LOCK | blobs) ;;
            *) set -- "$@" "$entry" ;;
        esac
    done
    # A store of the log and the blob tree alone leaves no entry: GNU tar 1.35 exits 2 on a `-C`
    # no member follows (CI, 2026-11-24).
    [ "$#" -eq 0 ] || set -- -C "$store" "$@"
    tar -czf "$work/$name" -C "$work" commit.sqlite3 "$@" || exit 2
fi

# Every file is staged before any is renamed, a pack before its manifest and both before the
# archive whose log names their blobs: no final name ever holds part of a file, and an archive in
# the folder has its packs.
set -- "$name"
if [ -f "$work/$pack" ]; then
    set -- "$pack" "$pack.manifest" "$name"
    put "$work/$pack" "$pack"
    held=$((held + bytes))
    put "$work/$pack.manifest" "$pack.manifest"
fi
put "$work/$name" "$name"
for file; do
    as_www mv -- "$dir/.$file.part" "$dir/$file" ||
        { echo "renaming $dir/.$file.part failed" >&2; exit 7; }
done
staged=''
as_www php occ files:scan "--path=$scanned" || { echo "occ files:scan $scanned failed" >&2; exit 7; }
# files:scan exits 0 on an unknown user or a path it cannot find; info:file exits 1 on a file it
# does not know (Nextcloud 30 to 32 source, read 2026-11-18).
for file; do
    known=$(as_www php occ info:file "/$scanned/$file") || {
        printf '%s\n' "$known" >&2
        echo "Nextcloud does not know $scanned/$file after the scan" >&2
        exit 7
    }
done

tmp="$NEWSVAULT_TEXTFILE_DIR/.$prom.$$"
if ! {
    echo "# TYPE $stamp gauge"
    echo "$stamp $at"
    echo "# TYPE $size gauge"
    echo "$size $bytes"
    if [ -n "$packs" ]; then
        echo "# TYPE newsvault_backup_packs_bytes gauge"
        echo "newsvault_backup_packs_bytes $held"
    fi
} >"$tmp" || ! mv -f "$tmp" "$NEWSVAULT_TEXTFILE_DIR/$prom"; then
    rm -f "$tmp"
    exit 2
fi

# Deletes only names of the copy's shape and a killed run's staging files, and nothing unless the
# copy just written is the newest the listing holds: otherwise it would be among the oldest.
listing=$(as_www ls -1A -- "$dir") || { echo "listing $dir failed; nothing deleted" >&2; exit 8; }
names=$(printf '%s\n' "$listing" | grep -x "$copy" | sort -u)
newest=$(printf '%s\n' "$names" | tail -n 1)
if [ "$newest" != "$name" ]; then
    echo "$dir does not end with $name: its newest copy is '$newest'; nothing deleted" >&2
    exit 8
fi
set --
excess=$(($(printf '%s\n' "$names" | wc -l) - keep))
if [ "$excess" -gt 0 ]; then
    for old in $(printf '%s\n' "$names" | head -n "$excess"); do
        set -- "$@" "$dir/$old"
    done
fi
leftovers() {
    printf '%s\n' "$listing" | grep -x "\\.$1\\.part"
}
for left in $(
    leftovers "$copy"
    [ -z "$packs" ] || { leftovers "$packs$stamped"; leftovers "$packs$stamped\\.manifest"; }
); do
    set -- "$@" "$dir/$left"
done
if [ "$#" -gt 0 ]; then
    as_www rm -f -- "$@" || { echo "deleting the oldest copies in $dir failed" >&2; exit 8; }
    as_www php occ files:scan "--path=$scanned" ||
        { echo "occ files:scan $scanned after the deletion failed" >&2; exit 8; }
fi
echo "wrote $name, $bytes bytes, to $scanned; kept the $keep newest${packs:+; the packs hold $held bytes}"
if [ "$packed" = 8 ]; then
    echo "blobs pack exited 8 and names the cause above: under lost or unrecorded, a pack in $dir that is gone, of another length or sha256, or without a whole manifest, whose blobs tonight's pack holds again; under not_packed, a blob or dictionary the log names that the store could not give, which is in no pack and is tried again every night. The log archive and every blob the store gave are written, and no pack or manifest was deleted" >&2
    exit 8
fi
