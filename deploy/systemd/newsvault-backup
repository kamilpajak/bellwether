#!/bin/sh
# The daily copy of one store into Nextcloud (architecture.md section 10, N1). No argument, run by
# newsvault-backup.service under the store lock: `newsvault snapshot` of the commit log plus every
# other store file. `modelgate`, run by modelgate-backup.service: `modelgate snapshot` under the
# shadow lock, then `modelgate verify` of the copy. Either way one .tar.gz, written into the data
# directory through the AIO container as www-data, registered with `occ files:scan` and found by
# `occ info:file`, then all but the 7 newest copies of that store deleted. Exits: 2 setup or an
# unsafe setting, 4 an absent input, 7 a held lock, a snapshot past its bound, the write, rename,
# scan or lookup, 8 the copy is in and the retention failed; else the snapshot's or verify's own.
set -u
export LC_ALL=C
: "${NEWSVAULT_IMAGE:?set in newsvault.env}" "${NEWSVAULT_TEXTFILE_DIR:?set in newsvault.env}"
case $NEWSVAULT_TEXTFILE_DIR in
    /*) ;;
    *) echo "NEWSVAULT_TEXTFILE_DIR is not an absolute path: '$NEWSVAULT_TEXTFILE_DIR'" >&2; exit 2 ;;
esac
keep=7
# The shadow lock is held within lock_wait + snapshot_bound + snapshot_kill of the start;
# services/newsvault/tests/deploy.rs holds that between two shadow firings.
lock_wait=760
snapshot_bound=150
snapshot_kill=20
case $#:${1-} in
    0:)
        what=vault
        prom=newsvault-backup.prom
        stamp=newsvault_backup_last_success_timestamp_seconds
        size=newsvault_backup_last_success_bytes
        ;;
    1:modelgate)
        what=modelgate
        prom=modelgate-backup.prom
        stamp=modelgate_backup_last_success_timestamp_seconds
        size=modelgate_backup_last_success_bytes
        : "${XDG_RUNTIME_DIR:?not set: run as the unit does, or from a login session}"
        ;;
    *) echo "usage: newsvault-backup [modelgate]" >&2; exit 2 ;;
esac
store="$HOME/.bellwether/$what"
copy="bellwether-$what-"'[0-9]\{8\}T[0-9]\{6\}Z\.tar\.gz'

# check NAME VALUE KIND, KIND one of word, absolute, relative: every '/'-separated part starts with a
# letter or digit and holds only letters, digits, '.', '_' and '-'.
check() {
    value=$2
    case $3:$value in
        word: | word:*/* | absolute: | absolute:[!/]* | relative: | relative:/* | *:*/ | *:*//*)
            echo "$1 is unsafe: '$value'" >&2; exit 2 ;;
    esac
    saved_ifs=$IFS
    IFS=/
    set -f
    for part in ${value#/}; do
        case $part in
            '' | [!A-Za-z0-9]* | *[!A-Za-z0-9._-]*) echo "$1 is unsafe: '$value'" >&2; exit 2 ;;
        esac
    done
    set +f
    IFS=$saved_ifs
}
check NEXTCLOUD_CONTAINER "${NEXTCLOUD_CONTAINER-}" word
check NEXTCLOUD_DATA "${NEXTCLOUD_DATA-}" absolute
check NEXTCLOUD_USER "${NEXTCLOUD_USER-}" word
check NEXTCLOUD_FOLDER "${NEXTCLOUD_FOLDER-}" relative
[ -d "$store" ] || { echo "no store at $store" >&2; exit 4; }

container=$NEXTCLOUD_CONTAINER
dir="$NEXTCLOUD_DATA/$NEXTCLOUD_USER/files/$NEXTCLOUD_FOLDER"
scanned="$NEXTCLOUD_USER/files/$NEXTCLOUD_FOLDER"
as_www() {
    docker exec -u www-data "$container" "$@"
}

mkdir -p "$HOME/.cache/bellwether" || exit 2
work=$(mktemp -d "$HOME/.cache/bellwether/backup.XXXXXX") || exit 2
staged=''
trap 'rm -rf "$work"; if [ -n "$staged" ]; then as_www rm -f -- "$staged"; fi' EXIT
trap 'exit 130' INT TERM

at=$(date -u +%s)
name="bellwether-$what-$(date -u +%Y%m%dT%H%M%SZ).tar.gz"
if [ "$what" = modelgate ]; then
    # The archive is the snapshot's output and nothing else of the store: the database and the
    # blobs its rows name. A shadow run that fired while the lock is held here would exit 7.
    set -- --pull never --user "$(id -u):$(id -g)" --read-only --network none \
        --cap-drop ALL --security-opt no-new-privileges --entrypoint /usr/bin/tini \
        --mount "type=bind,src=$work,dst=/out"
    flock --timeout "$lock_wait" --conflict-exit-code 7 "$XDG_RUNTIME_DIR/bellwether-shadow.lock" \
        timeout --kill-after "$snapshot_kill" "$snapshot_bound" \
        docker run --rm --name modelgate-backup "$@" \
        --mount "type=bind,src=$store,dst=/modelgate,readonly" \
        "$NEWSVAULT_IMAGE" -- /usr/local/bin/modelgate \
        snapshot --store /modelgate --out /out/store --non-interactive --format json
    status=$?
    case $status in
        0) ;;
        7) echo "a shadow run held its lock for $lock_wait s, or the store's LOCK is held; no copy taken" >&2; exit 7 ;;
        124 | 137)
            docker rm --force modelgate-backup >/dev/null 2>&1
            echo "the snapshot passed its $snapshot_bound s bound; no copy taken" >&2
            exit 7
            ;;
        *) exit "$status" ;;
    esac
    docker run --rm --name modelgate-backup-verify "$@" \
        "$NEWSVAULT_IMAGE" -- /usr/local/bin/modelgate \
        verify --store /out/store --non-interactive --format json || exit
    tar -czf "$work/$name" -C "$work/store" gate.sqlite blobs || exit 2
else
    docker run --rm --name newsvault-backup --pull never \
        --user "$(id -u):$(id -g)" --read-only --network none \
        --cap-drop ALL --security-opt no-new-privileges \
        --mount "type=bind,src=$store,dst=/vault,readonly" \
        --mount "type=bind,src=$work,dst=/out" \
        "$NEWSVAULT_IMAGE" \
        snapshot --out /out/commit.sqlite3 --non-interactive --format json || exit

    # The live log and its lock stay out: the snapshot is the archive's commit.sqlite3.
    cd "$store" || exit 4
    set --
    for entry in * .[!.]* ..?*; do
        [ -e "$entry" ] || continue
        case $entry in
            commit.sqlite3 | commit.sqlite3-* | LOCK) ;;
            *) set -- "$@" "$entry" ;;
        esac
    done
    tar -czf "$work/$name" -C "$work" commit.sqlite3 -C "$store" "$@" || exit 2
fi
bytes=$(wc -c <"$work/$name" | tr -d ' ')

as_www mkdir -p -- "$dir" || { echo "creating $dir in $container failed" >&2; exit 7; }
# Written under a hidden name and renamed, so the final name never holds part of a copy. Nextcloud's
# scanner skips the `.part` extension (Scanner::isPartialFile, 30 to 32 source, read 2026-11-18).
staged="$dir/.$name.part"
written=$(docker exec -i -u www-data "$container" sh -c 'cat >"$1" && wc -c <"$1"' sh "$staged" \
    <"$work/$name") || { echo "writing $staged in $container failed" >&2; exit 7; }
written=$(printf '%s' "$written" | tr -d ' \n')
if [ "$written" != "$bytes" ]; then
    echo "$staged holds $written of $bytes bytes; not renamed" >&2
    exit 7
fi
as_www mv -- "$staged" "$dir/$name" || { echo "renaming $staged failed" >&2; exit 7; }
staged=''
as_www php occ files:scan "--path=$scanned" || { echo "occ files:scan $scanned failed" >&2; exit 7; }
# files:scan exits 0 on an unknown user or a path it cannot find; info:file exits 1 on a file it
# does not know (Nextcloud 30 to 32 source, read 2026-11-18).
known=$(as_www php occ info:file "/$scanned/$name") || {
    printf '%s\n' "$known" >&2
    echo "Nextcloud does not know $scanned/$name after the scan" >&2
    exit 7
}

tmp="$NEWSVAULT_TEXTFILE_DIR/.$prom.$$"
if ! {
    echo "# TYPE $stamp gauge"
    echo "$stamp $at"
    echo "# TYPE $size gauge"
    echo "$size $bytes"
} >"$tmp" || ! mv -f "$tmp" "$NEWSVAULT_TEXTFILE_DIR/$prom"; then
    rm -f "$tmp"
    exit 2
fi

# Deletes only names of the copy's shape and a killed run's staging files, and nothing unless the
# copy just written is the newest the listing holds: otherwise it would be among the oldest.
listing=$(as_www ls -1A -- "$dir") || { echo "listing $dir failed; nothing deleted" >&2; exit 8; }
names=$(printf '%s\n' "$listing" | grep -x "$copy" | sort -u)
newest=$(printf '%s\n' "$names" | tail -n 1)
if [ "$newest" != "$name" ]; then
    echo "$dir does not end with $name: its newest copy is '$newest'; nothing deleted" >&2
    exit 8
fi
set --
excess=$(($(printf '%s\n' "$names" | wc -l) - keep))
if [ "$excess" -gt 0 ]; then
    for old in $(printf '%s\n' "$names" | head -n "$excess"); do
        set -- "$@" "$dir/$old"
    done
fi
for left in $(printf '%s\n' "$listing" | grep -x "\\.$copy\\.part"); do
    set -- "$@" "$dir/$left"
done
if [ "$#" -gt 0 ]; then
    as_www rm -f -- "$@" || { echo "deleting the oldest copies in $dir failed" >&2; exit 8; }
    as_www php occ files:scan "--path=$scanned" ||
        { echo "occ files:scan $scanned after the deletion failed" >&2; exit 8; }
fi
echo "wrote $name, $bytes bytes, to $scanned; kept the $keep newest"
