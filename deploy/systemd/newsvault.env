# Copied to ~/.config/bellwether/newsvault.env at install and edited there; holds no secret.
# The image by version tag and digest, so a moved tag cannot change what runs.
NEWSVAULT_IMAGE=ghcr.io/kamilpajak/bellwether-newsvault:vX.Y.Z@sha256:REPLACE_WITH_THE_PUSHED_DIGEST
# node-exporter's --collector.textfile.directory, writable by this user. It differs between
# installs, so the placeholder is not a path and every script refuses it until it is replaced.
NEWSVAULT_TEXTFILE_DIR=<node-exporter-textfile-directory>
# The daily backup's Nextcloud (architecture.md section 10, N1): the AIO container it writes
# through as www-data, its data directory as that container mounts it, the Nextcloud user ID and
# the folder in that user's files. Letters, digits, '.', '_' and '-' only; the script refuses others,
# so the user placeholder below must be replaced on the VPS before the first run.
NEXTCLOUD_CONTAINER=nextcloud-aio-nextcloud
NEXTCLOUD_DATA=/mnt/ncdata
NEXTCLOUD_USER=<nextcloud-user-id>
NEXTCLOUD_FOLDER=Backups/bellwether
# The shadow run (architecture.md section 3.5, "The shadow run on the VPS"); no value has a default
# and deploy/systemd/modelgate-shadow refuses each placeholder. The key is not here: it is the file
# ~/.config/bellwether/model-key, mode 0600. The model is a dated build, <id>-YYYYMMDD. The caps
# are USD over the gate's whole store; the script refuses a total above the owner's 15. The limit
# is the most requests one timer run sends, so that it ends inside the unit's TimeoutStartSec.
MODELGATE_MODEL=<dated-build-id>
MODELGATE_RUN_CAP_USD=<usd>
MODELGATE_DAY_CAP_USD=<usd>
MODELGATE_TOTAL_CAP_USD=<usd>
MODELGATE_INPUT_PRICE_PER_MTOK=<usd-per-million-input-tokens>
MODELGATE_GIVE_UP_AFTER_HOURS=<hours>
MODELGATE_LIMIT=<requests-per-run>
MODELGATE_QUESTIONS=/usr/share/bellwether/questions/ripple-shadow-1.json
# The embed step of the same run (architecture.md section 3.5, "Repeated releases"): record only.
# All nine or none: with none the step is off, and a refused one turns it off without stopping the
# labelling. The model has no dated build, so the provider slug and its quantization pin it; raise
# the epoch when the provider's serving is seen to change. The caps are USD over the embed file
# alone; the script refuses the step when this total and MODELGATE_TOTAL_CAP_USD together pass 15.
MODELGATE_EMBED_MODEL=<embedding-model-id>
MODELGATE_EMBED_PROVIDER=<provider-slug>
MODELGATE_EMBED_QUANTIZATION=<quantization>
MODELGATE_EMBED_EPOCH=<epoch>
MODELGATE_EMBED_PRICE_PER_MTOK=<usd-per-million-input-tokens>
MODELGATE_EMBED_LIMIT=<stories-per-run>
MODELGATE_EMBED_RUN_CAP_USD=<usd>
MODELGATE_EMBED_DAY_CAP_USD=<usd>
MODELGATE_EMBED_TOTAL_CAP_USD=<usd>
