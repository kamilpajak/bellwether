#!/bin/sh
# Compares bellwether's three touchpoints in the VPS's shared monitoring stack with this repository
# (architecture.md section 10, V4): the installed rule file's sha256, its prometheus.yml rule_files
# entry, the rules Prometheus loaded and their health, and Alertmanager's route for every alert.
# Reads only. Never prints alertmanager.yml or amtool's errors: its receivers hold the chat's
# credentials. Exits: 0 no drift, 1 drift found, 2 setup, 4 an absent input, 7 Prometheus or
# Alertmanager did not answer.
set -u
export LC_ALL=C
here=$(dirname "$0")
rules="$here/../prometheus/newsvault.rules.yml"
rule_files="$here/prometheus.rule_files.yml"
route="$here/alertmanager.route.yml"
monitoring=${MONITORING_DIR:-$HOME/monitoring}
prometheus=${PROMETHEUS_URL:-http://127.0.0.1:9090}
container=${ALERTMANAGER_CONTAINER:-alertmanager}
am_config=${ALERTMANAGER_CONFIG:-/etc/alertmanager/alertmanager.yml}
muted=blackhole

for tool in curl docker sha256sum awk sed grep sort; do
    command -v "$tool" >/dev/null || { echo "$tool is not on PATH" >&2; exit 2; }
done
case $monitoring in
    /*) ;;
    *) echo "MONITORING_DIR is not an absolute path: '$monitoring'" >&2; exit 2 ;;
esac
for input in "$rules" "$rule_files" "$route" "$monitoring/prometheus/prometheus.yml"; do
    [ -f "$input" ] || { echo "no file at $input" >&2; exit 4; }
done

entry=$(sed -n 's/^  - \([A-Za-z0-9._-]*\)$/\1/p' "$rule_files")
group=$(sed -n 's/^  - name: \([A-Za-z0-9_-]*\)$/\1/p' "$rules")
regex=$(sed -n 's/^ *- alertname=~"\([A-Za-z0-9|()]*\)"$/\1/p' "$route")
repeat=$(sed -n 's/^ *repeat_interval: *\([0-9a-z]*\)$/\1/p' "$route")
alerts=$(sed -n 's/^ *- alert: \([A-Za-z0-9]*\)$/\1/p' "$rules" | sort)
# need WHAT VALUE: exactly one line, or for the alert names at least one.
need() {
    case $2 in
        '') echo "the repository's monitoring files name no $1" >&2; exit 2 ;;
        *"
"*) [ "$1" = alert ] || { echo "the repository's monitoring files name $1 twice" >&2; exit 2; } ;;
    esac
}
need rule_files_entry "$entry"
need rule_group "$group"
need route_matcher "$regex"
need repeat_interval "$repeat"
need alert "$alerts"
# Lines of $2 that $1 lacks.
lacking() {
    HAVE=$1 awk 'BEGIN { n = split(ENVIRON["HAVE"], h, "\n"); for (i = 1; i <= n; i++) seen[h[i]] = 1 }
        $0 != "" && !($0 in seen)' <<EOF
$2
EOF
}

# Seconds of a Prometheus duration such as 49h or 2d1h; -1 for anything else.
seconds='function seconds(d,   total, part, unit) {
    total = 0
    while (match(d, /^[0-9]+(ms|[ywdhms])/)) {
        part = substr(d, 1, RLENGTH); d = substr(d, RLENGTH + 1)
        unit = part; sub(/^[0-9]+/, "", unit)
        total += (part + 0) * (unit == "y" ? 31536000 : unit == "w" ? 604800 : unit == "d" ? 86400 : unit == "h" ? 3600 : unit == "m" ? 60 : unit == "s" ? 1 : 0)
    }
    return d == "" ? total : -1
}'
want_repeat=$(awk -v d="$repeat" "$seconds"' BEGIN { print seconds(d) }')

drift=0
ok() { echo "ok $*"; }
no() { echo "drift $*"; drift=$((drift + 1)); }

installed="$monitoring/prometheus/$entry"
want=$(sha256sum <"$rules" | awk '{ print $1 }')
if [ -f "$installed" ]; then
    got=$(sha256sum <"$installed" | awk '{ print $1 }')
    if [ "$got" = "$want" ]; then
        ok "rules_file: $installed sha256 $got"
    else
        no "rules_file: $installed sha256 $got, the repository's $want"
    fi
else
    no "rules_file: no file at $installed"
fi

listed=$(awk -v entry="$entry" '
    /^[^[:space:]#]/ { inside = ($0 ~ /^rule_files:/); next }
    inside { line = $0; sub(/#.*/, "", line); gsub(/[[:space:]"'"'"']/, "", line); if (line == "-" entry) found = 1 }
    END { print found + 0 }' "$monitoring/prometheus/prometheus.yml")
if [ "$listed" = 1 ]; then
    ok "rule_files: prometheus.yml lists $entry"
else
    no "rule_files: prometheus.yml lists no $entry under rule_files"
fi

body=$(curl -fsS --max-time 10 -G --data-urlencode "rule_group[]=$group" --data-urlencode type=alert \
    "$prometheus/api/v1/rules") || { echo "Prometheus at $prometheus did not answer" >&2; exit 7; }
# Compact JSON split at , { and [: a key at a line's start is never inside a string, whose quotes
# are escaped.
fields=$(printf '%s\n' "$body" | awk '{ gsub(/[,{[]/, "\n"); print }')
value() {
    printf '%s\n' "$fields" | sed -n "s/^\"$1\":\"\\([^\"]*\\)\".*/\\1/p"
}
files=$(value file)
loaded=$(value name | sed 1d | sort)
count=$(printf '%s\n' "$alerts" | wc -l | tr -d ' ')
healthy=$(value health | grep -cx ok)
health_lines=$(value health | grep -c .)
case $files in
    *"
"* | '') no "prometheus: $(printf '%s\n' "$files" | grep -c .) rule files answer for group $group, not one" ;;
    */"$entry")
        if [ "$(value name | sed -n 1p)" = "$group" ] && [ "$loaded" = "$alerts" ] &&
            [ "$healthy" = "$count" ] && [ "$health_lines" = "$count" ]; then
            ok "prometheus: group $group from $files, $count rules, all health ok"
        else
            no "prometheus: group $group from $files holds $(printf '%s\n' "$loaded" | grep -c .) of the repository's $count rules, $healthy health ok"
            lacking "$loaded" "$alerts" | sed 's/^/  not loaded: /'
            lacking "$alerts" "$loaded" | sed 's/^/  not in the repository: /'
        fi
        ;;
    *) no "prometheus: group $group is read from $files, not from $entry" ;;
esac

amtool() {
    docker exec "$container" amtool "$@" 2>/dev/null
}
for alert in $alerts; do
    tree=$(amtool config routes test "--config.file=$am_config" --tree "alertname=$alert") ||
        { echo "amtool in container $container did not route $alert" >&2; exit 7; }
    receivers=$(printf '%s\n' "$tree" | sed -n '$p')
    matched=no
    if printf '%s\n' "$tree" | sed '$d' | grep -qF "$regex"; then matched=yes; fi
    expected=no
    if printf '%s\n' "$alert" | grep -qxE "$regex"; then expected=yes; fi
    case ,$receivers, in
        ,, | *,"$muted",*) no "route $alert: receivers '$receivers'" ;;
        *)
            if [ "$matched" = "$expected" ]; then
                ok "route $alert: $receivers, run_date route $matched"
            else
                no "route $alert: $receivers, run_date route $matched, expected $expected"
            fi
            ;;
    esac
done

shown=$(amtool config show --alertmanager.url=http://127.0.0.1:9093) ||
    { echo "Alertmanager in container $container did not show its running config" >&2; exit 7; }
# The repeat_interval at the key column of the route item whose matcher holds the regex.
repeats=$(printf '%s\n' "$shown" | awk -v regex="$regex" "$seconds"'
    function indent(s) { match(s, /^ */); return RLENGTH }
    { line[NR] = $0 }
    END {
        for (i = 1; i <= NR; i++) {
            if (index(line[i], regex) == 0 || line[i] !~ /^ *- /) continue
            k = -1
            for (j = i; j >= 1; j--) if (p = index(line[j], "matchers:")) { k = p - 1; break }
            if (k < 0) continue
            found = "unset"
            for (j = i + 1; j <= NR; j++) {
                if (line[j] ~ /^ *$/) continue
                if (indent(line[j]) < k) break
                if (indent(line[j]) == k && line[j] ~ /^ *repeat_interval:/) {
                    d = line[j]; sub(/^ *repeat_interval: */, "", d); gsub(/["'"'"' ]/, "", d)
                    found = seconds(d); break
                }
            }
            print found
        }
    }')
if [ "$repeats" = "$want_repeat" ]; then
    ok "repeat_interval: the running run_date route repeats every $repeat"
else
    no "repeat_interval: the running config's run_date routes repeat at '$(printf '%s' "$repeats" | tr '\n' ' ')' s, not $want_repeat s ($repeat)"
fi

if [ "$drift" -gt 0 ]; then
    echo "$drift drift(s) found"
    exit 1
fi
echo "no drift"
